# Pinned inputs for the shared FFmpeg build. Sourced by custom/*.sh.
# To update: pick a newer autobuild tag, copy the three names and hashes from
# its checksums.sha256 asset.

FFMPEG_REPO=vghuy17ck1/FFmpeg-Builds-SVT-AV1-Tritium
FFMPEG_RELEASE=autobuild-2026-09-28-13-00

# win64 uses the NVENC SDK 12.2 headers (works on driver 566.36)
FFMPEG_ASSET_WIN32_X64=ffmpeg-n8.1.3-6-gff48edd8b2-win64-nonfree-shared-nvsdk12-8.1.zip
FFMPEG_SHA256_WIN32_X64=0817cf1a37797d26173b9d740bdca5ac79a330aa4e369064627622f7abe39652

# Linux builds use the NVENC SDK 13.0 headers (driver 570 or newer)
FFMPEG_ASSET_LINUX_X64=ffmpeg-n8.1.3-6-gff48edd8b2-linux64-nonfree-shared-8.1.tar.xz
FFMPEG_SHA256_LINUX_X64=bf9932ee6b0efce2ed4f335e6ad8920a8c63d144930dbe16f8bd48e0dfedd8d3

FFMPEG_ASSET_LINUX_ARM64=ffmpeg-n8.1.3-6-gff48edd8b2-linuxarm64-nonfree-shared-8.1.tar.xz
FFMPEG_SHA256_LINUX_ARM64=deefe066f680117c8886933d86de1a982df10bc026a6d0acdc7d47c5df202360

# FFmpeg tag that custom/fftools/sync_queue.[ch] were copied from
SYNC_QUEUE_TAG=n8.1
